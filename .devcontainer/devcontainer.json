{
  "name": "CEWSIS PRO 2.0 Edge Workbench",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "CEWSIS PRO 2.0 dashboard", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt",
  "postStartCommand": "python -m uvicorn main:app --host 0.0.0.0 --port 8000",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}